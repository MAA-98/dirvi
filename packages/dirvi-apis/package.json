{
  "name": "dirvi-apis",
  "version": "0.11.0-beta.22",
  "description": "Public plugin and configuration APIs for dirvi.",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./dirvi": {
      "types": "./dist/dirvi.d.ts",
      "default": "./dist/dirvi.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.0.0",
    "zod": "^4.4.3"
  }
}
