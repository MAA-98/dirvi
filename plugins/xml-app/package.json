{
  "name": "@mak-98/xml-dirvi-app",
  "version": "0.11.0-beta.2",
  "description": "XML file app for dirvi.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier src --write",
    "publish": "pnpm --filter @mak-98/xml-dirvi-app publish --access public"
  },
  "dependencies": {
    "@rgrove/parse-xml": "^5.0.0",
    "dirvi-apis": "workspace:*",
    "dirvi-lib": "workspace:*",
    "env-paths": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
