{
  "name": "@mak-98/posix-fs-dirvi-app",
  "version": "0.11.0-beta.23",
  "description": "Filesystem app for dirvi.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier src --write",
    "publish": "pnpm --filter @mak-98/posix-fs-dirvi-app publish --access public --no-git-checks"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "env-paths": "^4.0.0"
  },
  "peerDependencies": {
    "dirvi-apis": "workspace:^"
  },
  "devDependencies": {
    "dirvi-apis": "workspace:*",
    "dirvi-lib": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
